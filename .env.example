# 监听端口
PORT=8080

# MySQL 连接地址
# 示例: mysql://root:password@localhost:3306/guchat
DATABASE_URL=

# JWT密钥，必要参数，可以设置一个长的随机字符串
JWT_SECRET=

# Access Token 有效期，单位秒
JWT_ACCESS_TTL_SECONDS=3600

# Refresh Token 有效期，单位秒
JWT_REFRESH_TTL_SECONDS=2592000

# Generation 默认上下文消息数量，当前端请求没有指定时使用，单位条
GENERATION_CONTEXT_LIMIT=25

# Generation 最大工具调用轮次
GENERATION_MAX_TOOL_ROUNDS=12

# Generation 最终写库失败后的重试间隔，单位秒
GENERATION_RETRY_INTERVAL_SECONDS=30

# Generation 最终写库失败后的最大重试次数
GENERATION_RETRY_MAX=5

# Tavily Search API Key，可选，配置后会启用 tavily_search 工具
TAVILY_API_KEY=

# Tavily Search API Base URL，可选，默认为 https://api.tavily.com
TAVILY_BASE_URL=https://api.tavily.com

# MCP 配置，可选。name 会作为工具名前缀，例如 tavily.tavily_extract
# MCP_SERVERS=[{"name":"tavily","url":"https://mcp.tavily.com/mcp/","auth_type":"query","auth_field":"tavilyApiKey","auth_key":"your-api-key"}]
MCP_SERVERS=
