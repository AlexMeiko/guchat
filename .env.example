# 监听端口
PORT=8080

# MySQL 连接地址
# 示例: mysql://root:password@localhost:3306/guchat
DATABASE_URL=

# JWT密钥，必要参数，可以设置一个长的随机字符串
JWT_SECRET=

# Access Token 有效期，单位秒
JWT_ACCESS_TTL_SECONDS=3600

# Refresh Token 有效期，单位秒
JWT_REFRESH_TTL_SECONDS=2592000

# Context 上下文 token 上限，达到压缩比例后会触发上下文摘要压缩
CONTEXT_TOKEN_LIMIT=256000

# Context 上下文压缩触发比例，例如 0.8 表示达到 CONTEXT_TOKEN_LIMIT 的 80% 时触发压缩
CONTEXT_COMPRESS_RATIO=0.8

# Generation 最大工具调用轮次
GENERATION_MAX_TOOL_ROUNDS=50

# Generation 最终写库失败后的重试间隔，单位秒
GENERATION_RETRY_INTERVAL_SECONDS=30

# Generation 最终写库失败后的最大重试次数
GENERATION_RETRY_MAX=5

# Sandbox 配置，可选。所有上传的文件和生成的内容都会存储在 SANDBOX_DATA_ROOT 指定的目录下
SANDBOX_ENABLED=false
SANDBOX_DATA_ROOT=./data/sandbox
SANDBOX_IMAGE=debian:bookworm-slim

# Tavily Search API Key，可选，配置后会启用 tavily_search 工具
TAVILY_API_KEY=

# Tavily Search API Base URL，可选，默认为 https://api.tavily.com
TAVILY_BASE_URL=https://api.tavily.com

# Memory RAG 配置，可选。完整配置后会启用记忆向量索引写入
# 示例：
# EMBEDDING_BASE_URL=http://localhost:8000/v1/embeddings
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
# DashScope 示例：
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=2048
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=guchat_memory_bge_m3_1024
# RAG_SPLITTER_API_URL=http://localhost:9000/predict

# Embedding 配置，可选。EMBEDDING_BASE_URL 必须填写最终请求地址；EMBEDDING_DIM 会作为 Qdrant collection 的 vector size
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=0

# Qdrant 配置，可选。
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_DISTANCE=Cosine
MEMORY_SIMILARITY_THRESHOLD=

# 外部切分 API 配置，可选。当前仅支持 external_api
RAG_SPLITTER_PROVIDER=external_api
RAG_SPLITTER_API_URL=
RAG_SPLITTER_API_HEADERS_JSON={}
RAG_SPLITTER_API_SEGMENTS_PATH=chunks

# MCP 配置，可选。name 会作为工具名前缀，例如 tavily.tavily_extract
# MCP_SERVERS=[{"name":"tavily","transport":"http","url":"https://mcp.tavily.com/mcp/","auth_type":"query","auth_field":"tavilyApiKey","auth_key":"your-api-key"}]
# MCP_SERVERS=[{"name":"github","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"env":["GITHUB_PERSONAL_ACCESS_TOKEN=your-token"]}]
MCP_SERVERS=
